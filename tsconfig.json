{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,

    "lib": ["ES2020", "DOM"],

    "strict": true,

    "noEmit": true,

    "skipLibCheck": true
  },
  "include": ["js/**/*.ts", "js/**/*.tsx"]
}
